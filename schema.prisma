// schema.prisma – SPEIS database schema (Prisma mirror of SQLite)
// Usage: npx prisma db push --schema schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./data/speis.db"
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  fullName     String?  @map("full_name")
  role         String   // admin | teacher | student
  studentReg   String?  @map("student_reg")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  createdAt    String?  @map("created_at")
  teacherClasses TeacherClass[]
  activityLogs ActivityLog[]
  @@map("users")
}

model Stream {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  subjects Subject[]
  careers  Career[]
  students Student[]
  @@map("streams")
}

model Subject {
  id       Int     @id @default(autoincrement())
  name     String
  streamId Int     @map("stream_id")
  stream   Stream  @relation(fields: [streamId], references: [id])
  marks    Mark[]
  examResults ExamResult[]
  cutoffs  CareerCutoff[]
  @@unique([name, streamId])
  @@map("subjects")
}

model Career {
  id       Int     @id @default(autoincrement())
  name     String
  streamId Int     @map("stream_id")
  stream   Stream  @relation(fields: [streamId], references: [id])
  cutoffs  CareerCutoff[]
  students Student[]
  @@unique([name, streamId])
  @@map("careers")
}

model CareerCutoff {
  id        Int     @id @default(autoincrement())
  careerId  Int     @map("career_id")
  subjectId Int     @map("subject_id")
  minMarks  Float   @map("min_marks")
  career    Career  @relation(fields: [careerId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])
  @@unique([careerId, subjectId])
  @@map("career_cutoffs")
}

model Student {
  regNo           String   @id @map("reg_no")
  admissionNo     String?  @unique @map("admission_no")
  fullName        String   @map("full_name")
  initialsName    String?  @map("initials_name")
  gender          String?
  dob             String?
  grade           Int      @default(10)
  classSection    String   @default("A") @map("class_section")
  medium          String?  @default("Sinhala")
  parentName      String?  @map("parent_name")
  contactNo       String?  @map("contact_no")
  email           String?
  streamId        Int?     @map("stream_id")
  careerId        Int?     @map("career_id")
  olYear          Int?     @map("ol_year")
  alBatch         String?  @map("al_batch")
  alStream        String?  @map("al_stream")
  universityGoal  String?  @map("university_goal")
  preferredDegree String?  @map("preferred_degree")
  careerGoal      String?  @map("career_goal")
  targetUniversity String? @map("target_university")
  stream   Stream?  @relation(fields: [streamId], references: [id])
  career   Career?  @relation(fields: [careerId], references: [id])
  marks    Mark[]
  examResults ExamResult[]
  @@map("students")
}

model Mark {
  id        Int     @id @default(autoincrement())
  regNo     String  @map("reg_no")
  subjectId Int     @map("subject_id")
  term      Int
  year      Int
  grade     Int     @default(10)
  marks     Float
  student   Student @relation(fields: [regNo], references: [regNo])
  subject   Subject @relation(fields: [subjectId], references: [id])
  @@unique([regNo, subjectId, term, year])
  @@map("marks")
}

model ExamResult {
  id          Int     @id @default(autoincrement())
  regNo       String  @map("reg_no")
  examType    String  @map("exam_type")
  examYear    Int     @map("exam_year")
  subjectId   Int     @map("subject_id")
  resultGrade String  @map("result_grade")
  enteredAt   String? @map("entered_at")
  student     Student @relation(fields: [regNo], references: [regNo])
  subject     Subject @relation(fields: [subjectId], references: [id])
  @@unique([regNo, examType, examYear, subjectId])
  @@map("exam_results")
}

model TeacherClass {
  id           Int    @id @default(autoincrement())
  teacherId    Int    @map("teacher_id")
  grade        Int
  classSection String @map("class_section")
  year         Int
  teacher      User   @relation(fields: [teacherId], references: [id])
  @@unique([teacherId, grade, classSection, year])
  @@map("teacher_classes")
}

model ActivityLog {
  id     Int    @id @default(autoincrement())
  userId Int?   @map("user_id")
  action String?
  ts     String?
  user   User?  @relation(fields: [userId], references: [id])
  @@map("activity_logs")
}
